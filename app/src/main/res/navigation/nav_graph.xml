<navigation xmlns:android="http://android.com"
    xmlns:app="http://android.com"
    xmlns:tools="http://android.com"
    android:id="@+id/nav_graph"
    app:startDestination="@id/customerLoginActivity"> <!-- Veya ortak bir karşılama ekranı -->

    <activity
        android:id="@+id/customerLoginActivity"
        android:name="com.example.cargo.login.CustomerLoginActivity"
        tools:layout="@layout/activity_customer_login">
        <action
            android:id="@+id/action_login_to_customerDashboard"
            app:destination="@id/customerDashboardFragment" />
    </activity>

    <activity
        android:id="@+id/courierLoginActivity"
        android:name="com.example.cargo.login.CourierLoginActivity"
        tools:layout="@layout/activity_courier_login">
        <action
            android:id="@+id/action_login_to_courierDashboard"
            app:destination="@id/courierDashboardFragment" />
    </activity>

    <fragment
        android:id="@+id/customerDashboardFragment"
        android:name="com.example.cargo.ui.dashboard.CustomerDashboardFragment"
        tools:layout="@layout/fragment_customer_dashboard">
        <action
            android:id="@+id/action_customer_to_tracking"
            app:destination="@id/loadTrackingFragment" />
    </fragment>

    <fragment
        android:id="@+id/courierDashboardFragment"
        android:name="com.example.cargo.ui.dashboard.CourierDashboardFragment"
        tools:layout="@layout/fragment_courier_dashboard">
        <action
            android:id="@+id/action_courier_to_tracking"
            app:destination="@id/loadTrackingFragment" />
    </fragment>

    <fragment
        android:id="@+id/loadTrackingFragment"
        android:name="com.example.cargo.ui.tracking.LoadTrackingFragment"
        tools:layout="@layout/fragment_load_tracking" />
</navigation>
